# This file is safe to commit. Copy it to .env and insert local credentials.
# The real .env is ignored by Git and should have permissions 600.

# Select auto, azure, or deepseek. Auto prefers a complete Azure configuration.
CF_PROVIDER=azure

# Azure OpenAI / Microsoft Foundry v1 (model is the deployment name).
OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
OPENAI_API_KEY=replace_me
GENERATION_MODEL=gpt-5-mini

# Optional DeepSeek alternative.
DEEPSEEK_API_KEY=replace_me

# Hugging Face. Public TOFU artifacts can also be accessed anonymously.
HF_TOKEN=replace_me
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DOWNLOAD_TIMEOUT=600
